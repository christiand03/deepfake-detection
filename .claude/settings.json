{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "c:\\Users\\Debbertin\\Downloads\\Belegarbeit\\deepfake-detection"
      ]
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "c:\\Users\\Debbertin\\Downloads\\Belegarbeit\\deepfake-detection\\data\\results.db"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/lint-python.ps1\"",
            "shell": "powershell",
            "timeout": 60,
            "statusMessage": "Running ruff on edited Python file..."
          }
        ]
      }
    ]
  }
}
