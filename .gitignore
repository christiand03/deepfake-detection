# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# ============================================================
# Virtual Environments
# ============================================================
/venv/
.venv/
env/

# ============================================================
# IDE / Editor
# ============================================================
.idea/
*.swp
*.swo
*~

# ============================================================
# ML Artifacts (large files – use DVC instead)
# ============================================================
*.pt
*.pth
*.h5
*.hdf5
*.onnx
*.safetensors
*.ckpt
data/
outputs/
logs/
wandb/
models/
artifacts/

# ============================================================
# Datasets (tracked via DVC, not Git)
# ============================================================
Datasets/**/*.mp4
Datasets/**/*.avi
Datasets/**/*.wav
Datasets/**/*.pt

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Environment / Secrets
# ============================================================
.env
.env.*
*.pem

# ============================================================
# Misc
# ============================================================
*.log
.cache/
/data
.whisperx_cache/
docs/kapitel/

# ============================================================
# Ausnahmen (Exceptions)
# ============================================================
# Den src-Ordner selbst nicht ignorieren
!src/

# Spezifische Unterordner im src-Ordner explizit wieder einschließen
!src/data/
!src/models/
!configs/data/

# ============================================================
# Obsidian Vault (team-shared KB under vault/)
# ============================================================
# Shared config (.obsidian/app.json, appearance.json, core-plugins.json,
# graph.json, daily-notes.json) IS committed. Per-user UI state is not:
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json
vault/.obsidian/cache
vault/.obsidian/*.bak
vault/.trash/

# Claude KB binding layer: machine-specific absolute paths.
# Each teammate binds their own clone (see vault/README.md).
.claude/project-memory/
